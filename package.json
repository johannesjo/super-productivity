{
  "name": "noura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/domain",
    "packages/application",
    "packages/platform",
    "packages/integrations",
    "packages/shared-schema",
    "packages/sync-core",
    "packages/sync-providers",
    "packages/noura-sync-server"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --filter '*' --if-present --sequential build",
    "check": "bun run --filter '*' --if-present --sequential check",
    "lint": "bun run --filter '*' --if-present --sequential lint",
    "format": "bun run --filter '*' --if-present --sequential format",
    "test": "bun run test:packages",
    "test:packages": "bun run --filter '@noura/*' --filter '@sp/*' --filter '@super-productivity/*' --if-present --sequential test",
    "test:client": "bun run --cwd apps/client test:unit --run",
    "test:e2e": "bun run --cwd apps/client test:e2e",
    "test:nourasync": "bun run --cwd packages/noura-sync-server test",
    "nourasync:dev": "bun run --cwd packages/noura-sync-server dev",
    "tauri:dev": "bun run --cwd apps/client tauri dev",
    "tauri:build": "bun run --cwd apps/client tauri build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
