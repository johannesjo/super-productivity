{
  "name": "Noura",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && ~/.bun/bin/bun install",
  "forwardPorts": [5173, 1900],
  "portsAttributes": {
    "5173": { "label": "Noura web", "onAutoForward": "openBrowser" },
    "1900": { "label": "SuperSync" }
  }
}
