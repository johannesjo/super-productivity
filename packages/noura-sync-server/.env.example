# NouraSync configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=1900

# PostgreSQL 16
DATABASE_URL=postgresql://nourasync:nourasync@localhost:5432/nourasync
DATABASE_POOL_SIZE=10

# Public authentication and client origins
PUBLIC_URL=https://sync.example.com
CORS_ENABLED=true
CORS_ORIGINS=https://app.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
JWT_SECRET=replace-with-at-least-32-random-characters

# WebAuthn / passkeys
WEBAUTHN_RP_ID=sync.example.com
WEBAUTHN_RP_NAME=NouraSync
WEBAUTHN_ORIGIN=https://sync.example.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NouraSync <noreply@example.com>

# Synchronization, quota, and retention
NOURASYNC_BATCH_UPLOAD=true
NOURASYNC_DEFAULT_STORAGE_QUOTA_BYTES=104857600
NOURASYNC_RETENTION_DAYS=45
OLD_OPS_CLEANUP_DELETE_BATCH_SIZE=5000
OLD_OPS_CLEANUP_MAX_DELETED_PER_RUN=25000

# Optional restrictions and logging
ALLOWED_EMAILS=
LOG_LEVEL=info
LOG_TO_FILE=false

# Optional privacy-page contact fields
PRIVACY_CONTACT_NAME=
PRIVACY_ADDRESS_STREET=
PRIVACY_ADDRESS_CITY=
PRIVACY_ADDRESS_COUNTRY=
PRIVACY_CONTACT_EMAIL=
