{
  "name": "@sp/shared-schema",
  "version": "1.0.0",
  "description": "Shared schema versioning and migrations for Noura sync",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": {
        "default": "./src/index.ts"
      },
      "require": {
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
